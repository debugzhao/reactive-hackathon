# 复制为 .env 后填写。只用测试专用钱包！.env 已在 .gitignore 中。
# 可以直接复用 starter/.env 里的同一个私钥（同一地址在各链分别需要余额）。
PRIVATE_KEY=0x...

BASE_RPC_URL=https://sepolia.base.org
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# Base Sepolia Callback Proxy（2026-11-21 对照 dev.reactive.network/origins-and-destinations 核实）
CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585

# ---- 可选参数（不填用默认值）----
# REACTIVE_FUND=1000000000000000000   # 部署 QueueReactive 时附带的 lREACT（wei），默认 1
# CALLBACK_BUDGET=30                  # 回调次数上限，用完自动退订
# MAX_PER_CALLBACK=10                 # 每次回调最多兑付几笔（N）
# CALLBACK_GAS_LIMIT=1500000          # 本地实测 1 次取回 + 10 笔兑付约 36 万 gas
# MIN_SETTLE_ASSETS=100000000         # 触发门槛 100 USDC（6 位小数）
# SETTLER_FUND=5000000000000000       # QueueSettler 附带的 ETH（wei），默认 0.005
# DEMO_DEPOSIT=10000000000            # 演示存款 10,000 USDC

# ---- 实验（bench/）用 ----
# 对手钱包：抢流动性实验需要（cast wallet new 生成，转一点 Base Sepolia ETH 进去）
# COMPETITOR_KEY=0x...
# 轮询机器人钱包：不填就复用 PRIVATE_KEY（脚本用 nonceManager 避免并发冲突）
# BOT_KEY=0x...
